BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5432
DEMO_POSTGRES_PORT=15433
DEMO_MYSQL_PORT=13306
DEMO_CLICKHOUSE_HTTP_PORT=18123
DEMO_CLICKHOUSE_NATIVE_PORT=19000
DEMO_MONGO_PORT=27018
DEMO_REDIS_PORT=16379
AIRFLOW_WEBSERVER_PORT=8080
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8081
AGENT_DEBUGGER_PORT=8090

NEXT_PUBLIC_API_URL=/api/backend
BACKEND_INTERNAL_URL=http://backend:8000

ARTIFACT_ROOT=infra
ARTIFACT_GIT_ENABLED=true
ARTIFACT_GIT_ROOT=infra
