    <element xsi:type="archimate:Node" name="agent-debugger" id="id-node-dbg"/>
    <element xsi:type="archimate:Node" name="redis (Celery broker)" id="id-node-redis"/>
    <element xsi:type="archimate:Node" name="backend-worker" id="id-node-bworker"/>
    <element xsi:type="archimate:Node" name="backend-beat" id="id-node-bbeat"/>
    <element xsi:type="archimate:Node" name="Sandbox: python:3.12-slim" id="id-node-sbx-py"/>
    <element xsi:type="archimate:Node" name="Sandbox: apache/airflow:2.10.4" id="id-node-sbx-af"/>
    <element xsi:type="archimate:Node" name="Sandbox: apache/spark:3.5.4" id="id-node-sbx-sp"/>
    <element xsi:type="archimate:Node" name="LLM Provider (MagnitGPT / OpenAI / OpenRouter)" id="id-node-llm"/>
    <element xsi:type="archimate:Node" name="Внешние БД пользователей  (1..N)&#10;PostgreSQL / MySQL / ClickHouse / MongoDB / Redis / ..." id="id-node-user-dbs"/>
    <element xsi:type="archimate:SystemSoftware" name="Node.js 20" id="id-ss-node"/>
    <element xsi:type="archimate:SystemSoftware" name="Python 3.12 + Uvicorn" id="id-ss-python"/>
