<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:archimate="http://www.archimatetool.com/archimate" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="AI Data Engineer Assistant - Physical Architecture" id="id-model-aida-physical" version="5.0.0">
  <folder name="Strategy" id="id-folder-strategy" type="strategy"/>
  <folder name="Business" id="id-folder-business" type="business">
    <element xsi:type="archimate:BusinessActor" name="Data Engineer" id="id-actor-de"/>
    <element xsi:type="archimate:BusinessActor" name="Администратор" id="id-actor-admin"/>
    <element xsi:type="archimate:BusinessRole" name="Пользователь LLM-агента" id="id-role-user"/>
    <element xsi:type="archimate:BusinessService" name="AI Data Engineer Assistant" id="id-bs-main"/>
    <element xsi:type="archimate:BusinessProcess" name="Отправка запроса" id="id-bp-send"/>
    <element xsi:type="archimate:BusinessProcess" name="Получение ответа и&#10;отображение в UI" id="id-bp-display"/>
    <element xsi:type="archimate:BusinessProcess" name="Получение запроса" id="id-bp-internal-recv"/>
    <element xsi:type="archimate:BusinessProcess" name="Анализ намерения и&#10;выбор инструмента" id="id-bp-intent"/>
    <element xsi:type="archimate:BusinessProcess" name="Обработка запроса в LLM&#10;(tool calling)" id="id-bp-llm-proc"/>
    <element xsi:type="archimate:BusinessProcess" name="Выполнение инструмента&#10;(SQL / Airflow / Spark / Sandbox / MCP)" id="id-bp-exec"/>
    <element xsi:type="archimate:BusinessProcess" name="Формирование ответа" id="id-bp-form"/>
  </folder>
  <folder name="Application" id="id-folder-application" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Next.js Frontend" id="id-ac-frontend"/>
    <element xsi:type="archimate:ApplicationComponent" name="FastAPI Backend" id="id-ac-backend"/>
    <element xsi:type="archimate:ApplicationFunction" name="AI Chat UI" id="id-af-chat"/>
    <element xsi:type="archimate:ApplicationFunction" name="SQL Workspace UI" id="id-af-sql-ui"/>
    <element xsi:type="archimate:ApplicationFunction" name="Pipelines UI" id="id-af-pipe-ui"/>
    <element xsi:type="archimate:ApplicationFunction" name="Catalog / Connections UI" id="id-af-catalog-ui"/>
    <element xsi:type="archimate:ApplicationFunction" name="Settings / Profile UI" id="id-af-settings-ui"/>
    <element xsi:type="archimate:ApplicationFunction" name="Получение запроса&#10;(REST API)" id="id-af-recv"/>
    <element xsi:type="archimate:ApplicationFunction" name="Авторизация (JWT)" id="id-af-auth"/>
    <element xsi:type="archimate:ApplicationFunction" name="Agent Orchestrator&#10;(LangGraph)" id="id-af-agent"/>
    <element xsi:type="archimate:ApplicationFunction" name="Обработка запроса в LLM&#10;(tool calling)" id="id-af-llm"/>
    <element xsi:type="archimate:ApplicationFunction" name="Tool Registry" id="id-af-tools"/>
    <element xsi:type="archimate:ApplicationFunction" name="SQL Executor&#10;(read-only)" id="id-af-sql-exec"/>
    <element xsi:type="archimate:ApplicationFunction" name="Airflow Client" id="id-af-airflow"/>
    <element xsi:type="archimate:ApplicationFunction" name="Spark Client" id="id-af-spark"/>
    <element xsi:type="archimate:ApplicationFunction" name="MCP Client" id="id-af-mcp"/>
    <element xsi:type="archimate:ApplicationFunction" name="Artifact Writer + Git" id="id-af-artifact"/>
    <element xsi:type="archimate:ApplicationFunction" name="Sandbox Client" id="id-af-sandbox"/>
    <element xsi:type="archimate:ApplicationFunction" name="Формирование ответа&#10;(intent + ui_actions)" id="id-af-resp"/>
    <element xsi:type="archimate:ApplicationFunction" name="Сохранение сессии,&#10;сообщений и tool_runs" id="id-af-persist"/>
    <element xsi:type="archimate:DataObject" name="Пользователи, сессии, сообщения" id="id-do-users"/>
    <element xsi:type="archimate:DataObject" name="Tool runs, версии артефактов" id="id-do-runs"/>
    <element xsi:type="archimate:DataObject" name="Метаданные Airflow" id="id-do-airflow-meta"/>
    <element xsi:type="archimate:ApplicationService" name="AI Data Engineer Service" id="id-as-api"/>
  </folder>
  <folder name="Technology &amp; Physical" id="id-folder-technology" type="technology">
    <element xsi:type="archimate:Node" name="Host Machine (Docker Engine)" id="id-node-host"/>
    <element xsi:type="archimate:Node" name="Docker" id="id-node-platform"/>
