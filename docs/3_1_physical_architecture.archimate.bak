    <element xsi:type="archimate:SystemSoftware" name="Docker Engine" id="id-ss-docker"/>
    <element xsi:type="archimate:SystemSoftware" name="Redis 7" id="id-ss-redis"/>
    <element xsi:type="archimate:SystemSoftware" name="Python 3.12 + Celery" id="id-ss-celery"/>
    <element xsi:type="archimate:Artifact" name="Next.js bundle" id="id-art-frontend"/>
    <element xsi:type="archimate:Artifact" name="FastAPI app + LangGraph" id="id-art-backend"/>
    <element xsi:type="archimate:Artifact" name="DAG files (infra/airflow/dags)" id="id-art-dags"/>
    <element xsi:type="archimate:Artifact" name="Spark jobs (infra/spark/jobs)" id="id-art-jobs"/>
    <element xsi:type="archimate:Artifact" name="/var/run/docker.sock" id="id-art-sock"/>
    <element xsi:type="archimate:Artifact" name="Volume: postgres-data" id="id-art-pgvol"/>
  </folder>
  <folder name="Motivation" id="id-folder-motivation" type="motivation"/>
  <folder name="Implementation &amp; Migration" id="id-folder-implementation_migration" type="implementation_migration"/>
